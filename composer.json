{
  "name": "noisywinds/laravel-smartmd",
  "description": "A modern Laravel Markdown editor with enhanced features and Laravel 12 compatibility",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "markdown", "editor", "codemirror", "math", "mermaid"],
  "authors": [
    {
      "name": "noisywinds",
      "email": "1624389686@qq.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "intervention/image-laravel": "^1.3",
    "erusev/parsedown": "^1.8.0-beta-7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "laravel/laravel": "^12.0",
    "orchestra/testbench": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "NoisyWinds\\Smartmd\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NoisyWinds\\Smartmd\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "NoisyWinds\\Smartmd\\SmartmdServiceProvider"
      ],
      "aliases": {
        "Smartmd": "NoisyWinds\\Smartmd\\Facades\\Smartmd"
      }
    },
    "branch-alias": {
      "dev-main": "2.0-dev"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  }
}
